---
/** RoPE Relative Distance — changing the relative distance between two tokens changes the angle between their rotated vectors */
---

<div class="mb-4 rounded-none border border-[#0e0c0a] bg-[#221d17] p-5 shadow-[3px_3px_0_rgba(0,0,0,0.35)]">
  <p class="mb-4 text-base leading-relaxed text-[#8a7d66]">
    Switch between the sentences and watch what happens. As the distance between <strong
      class="text-[#6fa8d0]">"astronaut"</strong
    > and
    <strong class="text-[#e8a33d]">"moon"</strong> changes, the angle between their
    vectors changes too.
  </p>

  <div class="mb-3 flex items-center gap-2">
    <span
      class="mr-1 text-[0.95rem] font-semibold tracking-wider text-[#8a7d66] uppercase"
      >Sentence:</span
    >
    <button
      id="rel-btn-a"
      class="cursor-pointer rounded-lg border border-amber-500/40 bg-amber-500/20 px-4 py-1.5 text-[0.95rem] font-semibold text-amber-200 transition-all duration-200"
    >
      "...explores the moon"
    </button>
    <button
      id="rel-btn-b"
      class="cursor-pointer rounded-lg border border-[#0e0c0a] bg-[#2a241d] px-4 py-1.5 text-[0.95rem] font-semibold text-[#8a7d66] transition-all duration-200 hover:text-[#c8bda6]"
    >
      "...did a flyby of the moon"
    </button>
  </div>

  <div class="mb-1 flex flex-wrap gap-1" id="rel-tokens"></div>
  <div class="mb-3 flex flex-wrap gap-1" id="rel-indices"></div>

  <div class="mb-4 flex flex-wrap gap-x-5 gap-y-1 text-[0.95rem] text-[#8a7d66]">
    <span
      ><span
        class="mr-1 inline-block h-2 w-2 rounded-full bg-[#6fa8d0] align-middle"
      ></span> astronaut pos <span
        id="rel-pos-a"
        class="font-mono text-[#e9e0d0]">1</span
      ></span
    >
    <span
      ><span
        class="mr-1 inline-block h-2 w-2 rounded-full bg-[#e8a33d] align-middle"
      ></span> moon pos <span id="rel-pos-m" class="font-mono text-[#e9e0d0]"
        >4</span
      ></span
    >
    <span
      >Relative distance: <span
        id="rel-delta"
        class="font-mono font-semibold text-[#6cc0a0]">3</span
      ></span
    >
    <span
      >&alpha;: <span
        class="font-mono font-semibold text-[#6cc0a0]"
        id="rel-angle-val"></span></span
    >
  </div>

  <div class="flex justify-center">
    <svg id="rel-plot" class="block"></svg>
  </div>
</div>

<style is:global>
  .stok {
    padding: 0.25rem 0.6rem;
    border-radius: 5px;
    font-size: 1rem;
    font-weight: 500;
    background: rgba(255, 255, 255, 0.04);
    color: #c8bda6;
    border: 1px solid transparent;
    transition: all 0.3s;
  }
  .stok.hl-a {
    background: rgba(111, 168, 208, 0.12);
    color: #6fa8d0;
    font-weight: 700;
    border-color: rgba(111, 168, 208, 0.25);
  }
  .stok.hl-m {
    background: rgba(232, 163, 61, 0.12);
    color: #e8a33d;
    font-weight: 700;
    border-color: rgba(232, 163, 61, 0.25);
  }
  .sidx {
    display: inline-block;
    padding: 0 0.6rem;
    text-align: center;
    font-size: 0.85rem;
    color: #8a7d66;
    font-variant-numeric: tabular-nums;
  }
  .sidx.hl-a {
    color: #6fa8d0;
    font-weight: 600;
  }
  .sidx.hl-m {
    color: #e8a33d;
    font-weight: 600;
  }
</style>

<script>
  import * as d3 from "d3";
  import {
    thetaSmol,
    renderTokens,
    ACTIVE_BTN,
    INACTIVE_BTN,
  } from "./rope-shared";

  const SENTS = {
    A: {
      tokens: ["The", "astronaut", "explores", "the", "moon."],
      aPos: 1,
      mPos: 4,
    },
    B: {
      tokens: ["The", "astronaut", "did", "a", "flyby", "of", "the", "moon."],
      aPos: 1,
      mPos: 7,
    },
  };
  let cur = "A" as "A" | "B";
  const K = 3;

  const btnA = document.getElementById("rel-btn-a")!;
  const btnB = document.getElementById("rel-btn-b")!;

  function renderSentence() {
    const s = SENTS[cur];
    renderTokens(
      document.getElementById("rel-tokens")!,
      document.getElementById("rel-indices")!,
      s.tokens,
      s.aPos,
      s.mPos
    );
    document.getElementById("rel-pos-a")!.textContent = String(s.aPos);
    document.getElementById("rel-pos-m")!.textContent = String(s.mPos);
    document.getElementById("rel-delta")!.textContent = String(s.mPos - s.aPos);
  }

  function buildPlot(animate: boolean) {
    const svg = d3.select("#rel-plot");
    const W = 540,
      H = 390,
      CX = W / 2,
      CY = H / 2,
      R = 165;
    const theta = thetaSmol(K);
    const s = SENTS[cur];
    const angA = s.aPos * theta,
      angM = s.mPos * theta,
      delta = (s.mPos - s.aPos) * theta;
    const laR = R + 20;
    const anchor = (c: number) =>
      c > 0.3 ? "start" : c < -0.3 ? "end" : "middle";
    const anchorA = anchor(Math.cos(angA));
    const anchorM = anchor(Math.cos(angM));
    const pA = [CX + R * Math.cos(angA), CY - R * Math.sin(angA)];
    const pM = [CX + R * Math.cos(angM), CY - R * Math.sin(angM)];
    const lA = [CX + laR * Math.cos(angA), CY - laR * Math.sin(angA)];
    const lM = [CX + laR * Math.cos(angM), CY - laR * Math.sin(angM)];
    const mid = angA + delta / 2;
    const lD = [CX + R * 0.6 * Math.cos(mid), CY - R * 0.6 * Math.sin(mid)];
    const dur = animate ? 600 : 0,
      ease = d3.easeCubicInOut;

    if (svg.select(".rel-orbit").empty()) {
      svg
        .attr("viewBox", `0 0 ${W} ${H}`)
        .attr("width", "100%")
        .style("max-width", `${W}px`);
      svg
        .append("circle")
        .attr("class", "rel-orbit")
        .attr("cx", CX)
        .attr("cy", CY)
        .attr("r", R)
        .attr("fill", "none")
        .attr("stroke", "rgba(255,255,255,0.06)")
        .attr("stroke-width", 1);
      svg
        .append("line")
        .attr("x1", CX - R - 10)
        .attr("x2", CX + R + 10)
        .attr("y1", CY)
        .attr("y2", CY)
        .attr("stroke", "rgba(255,255,255,0.04)");
      svg
        .append("line")
        .attr("x1", CX)
        .attr("x2", CX)
        .attr("y1", CY - R - 10)
        .attr("y2", CY + R + 10)
        .attr("stroke", "rgba(255,255,255,0.04)");
      svg
        .append("path")
        .attr("class", "rel-arc")
        .attr("fill", "rgba(108,192,160,0.10)")
        .attr("stroke", "#6cc0a0")
        .attr("stroke-width", 1.5)
        .attr("stroke-opacity", 0.5);
      svg
        .append("line")
        .attr("class", "rel-line-a")
        .attr("x1", CX)
        .attr("y1", CY)
        .attr("stroke", "#6fa8d0")
        .attr("stroke-width", 2)
        .attr("stroke-opacity", 0.5);
      svg
        .append("line")
        .attr("class", "rel-line-m")
        .attr("x1", CX)
        .attr("y1", CY)
        .attr("stroke", "#e8a33d")
        .attr("stroke-width", 2)
        .attr("stroke-opacity", 0.5);
      svg
        .append("circle")
        .attr("class", "rel-dot-a")
        .attr("r", 7)
        .attr("fill", "#6fa8d0")
        .attr("stroke", "#221d17")
        .attr("stroke-width", 2);
      svg
        .append("circle")
        .attr("class", "rel-dot-m")
        .attr("r", 7)
        .attr("fill", "#e8a33d")
        .attr("stroke", "#221d17")
        .attr("stroke-width", 2);
      svg
        .append("text")
        .attr("class", "rel-lbl-a")
        .attr("fill", "#6fa8d0")
        .attr("font-size", "0.95rem")
        .attr("font-weight", "600");
      svg
        .append("text")
        .attr("class", "rel-lbl-m")
        .attr("fill", "#e8a33d")
        .attr("font-size", "0.95rem")
        .attr("font-weight", "600");
      svg
        .append("text")
        .attr("class", "rel-lbl-d")
        .attr("fill", "#6cc0a0")
        .attr("font-size", "1rem")
        .attr("font-weight", "700")
        .attr("text-anchor", "middle");
    }

    svg
      .select(".rel-line-a")
      .transition()
      .duration(dur)
      .ease(ease)
      .attr("x2", pA[0])
      .attr("y2", pA[1]);
    svg
      .select(".rel-line-m")
      .transition()
      .duration(dur)
      .ease(ease)
      .attr("x2", pM[0])
      .attr("y2", pM[1]);
    svg
      .select(".rel-dot-a")
      .transition()
      .duration(dur)
      .ease(ease)
      .attr("cx", pA[0])
      .attr("cy", pA[1]);
    svg
      .select(".rel-dot-m")
      .transition()
      .duration(dur)
      .ease(ease)
      .attr("cx", pM[0])
      .attr("cy", pM[1]);
    svg
      .select(".rel-lbl-a")
      .transition()
      .duration(dur)
      .ease(ease)
      .attr("x", lA[0])
      .attr("y", lA[1])
      .attr("text-anchor", anchorA)
      .text("astronaut");
    svg
      .select(".rel-lbl-m")
      .transition()
      .duration(dur)
      .ease(ease)
      .attr("x", lM[0])
      .attr("y", lM[1])
      .attr("text-anchor", anchorM)
      .text("moon");

    const arcGen = d3
      .arc<any, any>()
      .innerRadius(R * 0.25)
      .outerRadius(R * 0.42)
      .startAngle(0)
      .endAngle(-delta);
    svg
      .select(".rel-arc")
      .transition()
      .duration(dur)
      .ease(ease)
      .attr("d", arcGen({} as any))
      .attr(
        "transform",
        `translate(${CX},${CY}) rotate(${-(90 - (angA * 180) / Math.PI)})`
      );

    const deg = ((delta * 180) / Math.PI).toFixed(1);
    svg
      .select(".rel-lbl-d")
      .transition()
      .duration(dur)
      .ease(ease)
      .attr("x", lD[0])
      .attr("y", lD[1])
      .text(`α = ${deg}°`);
    document.getElementById("rel-angle-val")!.textContent = `α = ${deg}°`;
  }

  function updateBtns() {
    btnA.className = cur === "A" ? ACTIVE_BTN : INACTIVE_BTN;
    btnB.className = cur === "B" ? ACTIVE_BTN : INACTIVE_BTN;
  }

  btnA.addEventListener("click", () => {
    if (cur !== "A") {
      cur = "A";
      updateBtns();
      renderSentence();
      buildPlot(true);
    }
  });
  btnB.addEventListener("click", () => {
    if (cur !== "B") {
      cur = "B";
      updateBtns();
      renderSentence();
      buildPlot(true);
    }
  });

  renderSentence();
  buildPlot(false);
</script>
