---
// The rail scaffold. Cards are populated client-side from the article's GFM
// footnotes (tagged `.margin-notes-source` by the rehype plugin). On narrow
// viewports the rail is hidden and those footnotes show inline instead.
interface Props {
  count: number;
}
const { count } = Astro.props;
---

{
  count > 0 && (
    <aside class="notes-rail" id="margin-rail" aria-label="Margin notes">
      <span class="mono-label notes-label">MARGIN.NOTES</span>
      <div class="notes-rule" aria-hidden="true" />
      <div class="notes-stack" id="notes-stack" />
    </aside>
  )
}

<style>
  .notes-label {
    display: block;
    font-size: 10px;
    margin-bottom: 8px;
  }
  .notes-rule {
    border-top: 1px dotted var(--divider);
    margin-bottom: 14px;
  }
</style>

<!-- Global (unscoped) — cards are generated by the client script, so scoped
     selectors would not reach them. -->
<style is:global>
  .note-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 0;
    box-shadow:
      inset 1px 1px 0 rgba(255, 255, 255, 0.08),
      3px 3px 0 rgba(0, 0, 0, 0.35);
    margin-bottom: 14px;
    transition:
      box-shadow 0.15s ease,
      transform 0.15s ease,
      border-color 0.15s ease;
  }
  .note-card .note-titlebar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 8px;
  }
  .note-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--bg);
    background: var(--accent);
    border: 1px solid var(--line);
  }
  .note-kind {
    font-size: 10px;
  }
  .note-body {
    padding: 10px 12px;
    font-family: var(--font-serif);
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-note);
  }
  .note-body p {
    margin: 0 0 0.5em;
  }
  .note-body p:last-child {
    margin-bottom: 0;
  }
  .note-card.is-linked {
    border-color: var(--accent);
    box-shadow:
      0 0 0 1px var(--accent),
      5px 5px 0 rgba(0, 0, 0, 0.4);
    transform: translate(-2px, -2px);
  }
</style>
