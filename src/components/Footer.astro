---
import { SOCIALS } from "@/constants";
import { SITE } from "@/config";
import IconRss from "@/assets/icons/IconRss.svg";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;

// GH · IN · MAIL from SOCIALS, plus the (already-live) RSS feed.
const footerLinks = [
  ...SOCIALS.map(s => ({ href: s.href, title: s.linkTitle, icon: s.icon })),
  {
    href: "/rss.xml",
    title: `${SITE.title} RSS feed`,
    icon: IconRss,
  },
];
---

<footer class:list={["site-footer bar-shine", { "no-margin-top": noMarginTop }]}>
  <div class="footer-inner">
    <span class="copyright">© {currentYear} {SITE.title}</span>
    <nav class="footer-links" aria-label="Social and feed links">
      {
        footerLinks.map((link, i) => (
          <>
            {i > 0 && (
              <span class="footer-sep" aria-hidden="true">
                ·
              </span>
            )}
            <a class="footer-link" href={link.href} title={link.title}>
              <link.icon />
              <span class="sr-only">{link.title}</span>
            </a>
          </>
        ))
      }
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    margin-top: auto;
    background: var(--surface-raised);
    border-top: 1px solid var(--line);
  }
  .site-footer.no-margin-top {
    margin-top: 0;
  }
  .footer-inner {
    max-width: 1360px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 32px;
  }
  .copyright {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .footer-links {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .footer-link {
    display: inline-flex;
    align-items: center;
    color: var(--text-muted);
  }
  .footer-link:hover {
    color: var(--accent);
  }
  .footer-link :global(svg) {
    width: 15px;
    height: 15px;
  }
  .footer-sep {
    color: var(--divider);
    font-size: 10px;
    line-height: 1;
  }

  @media (max-width: 720px) {
    .footer-inner {
      padding: 14px 16px;
    }
  }
</style>
