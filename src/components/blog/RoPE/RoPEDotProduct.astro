---
/** RoPE Dot Product — heatmap of cos(d·θ_k) for every pair × every distance out to 800 token positions. Static (no slider). Shows the frequency spectrum's effect on attention and how the reliable band of pairs narrows as distance grows. */
---

<div class="mb-4 rounded-xl border border-[#2e3347] bg-[#222738] p-5">
  <div class="max-w-[700px]">
    <!-- Color legend for cosine alignment -->
    <div class="mb-3 flex justify-center">
      <div class="w-full max-w-[420px]">
        <div
          class="mb-1 text-center text-[0.7rem] tracking-wider text-gray-500 uppercase"
        >
          Cosine alignment between q and k
        </div>
        <div
          class="h-3 w-full rounded-sm"
          style="background: linear-gradient(to right, #38bdf8, #2e3347, #fb923c);"
        >
        </div>
        <div class="mt-1 flex justify-between font-mono text-[0.72rem]">
          <span style="color:#38bdf8">−1 opposite</span>
          <span class="text-gray-400">0 perpendicular</span>
          <span style="color:#fb923c">+1 aligned</span>
        </div>
      </div>
    </div>

    <div class="overflow-x-auto">
      <svg id="dp-heatmap"></svg>
    </div>
  </div>
</div>

<script>
  import * as d3 from "d3";
  import { thetaSmol } from "./rope-shared";

  const NUM_PAIRS = 32;
  const D_MAX = 800;
  const SPLIT_K = 16;

  const colorOf = d3.interpolateRgbBasis(["#38bdf8", "#2e3347", "#fb923c"]);
  const colorAt = (cosVal: number) => colorOf((cosVal + 1) / 2);

  const margin = { top: 16, right: 16, bottom: 50, left: 56 };
  const width = 700,
    height = 360;
  const innerW = width - margin.left - margin.right;
  const innerH = height - margin.top - margin.bottom;

  const svg = d3
    .select("#dp-heatmap")
    .attr("viewBox", `0 0 ${width} ${height}`)
    .attr("width", "100%")
    .style("max-width", `${width}px`);

  const g = svg
    .append("g")
    .attr("transform", `translate(${margin.left}, ${margin.top})`)
    .attr("shape-rendering", "crispEdges");

  const x = d3.scaleLinear().domain([0, D_MAX]).range([0, innerW]);
  const y = d3
    .scaleBand<number>()
    .domain(d3.range(NUM_PAIRS))
    .range([0, innerH])
    .padding(0);

  const cellH = y.bandwidth();

  // Sample every 2 distances to keep cell count manageable (32 × 401 ≈ 13k cells).
  // Fast pair stripes are still resolved at this resolution; the savings vs full sampling
  // matter for slower devices.
  const SAMPLE_STEP = 2;
  const cellW = (innerW / (D_MAX + 1)) * SAMPLE_STEP;

  type Cell = { k: number; d: number; cos: number };
  const cells: Cell[] = [];
  for (let k = 0; k < NUM_PAIRS; k++) {
    const θ = thetaSmol(k);
    for (let d = 0; d <= D_MAX; d += SAMPLE_STEP) {
      cells.push({ k, d, cos: Math.cos(d * θ) });
    }
  }

  g.selectAll("rect.dp-cell")
    .data(cells)
    .enter()
    .append("rect")
    .attr("class", "dp-cell")
    .attr("x", c => x(c.d))
    .attr("y", c => y(c.k)!)
    .attr("width", cellW + 0.5)
    .attr("height", cellH + 0.5)
    .attr("fill", c => colorAt(c.cos));

  // Y-axis labels (every 4 pairs)
  [0, 4, 8, 12, 16, 20, 24, 28, 31].forEach(k => {
    g.append("text")
      .attr("x", -8)
      .attr("y", y(k)! + cellH / 2 + 4)
      .attr("text-anchor", "end")
      .attr("fill", "#9ca3af")
      .attr("font-size", "0.78rem")
      .text(`k=${k}`);
  });
  g.append("text")
    .attr("transform", "rotate(-90)")
    .attr("x", -innerH / 2)
    .attr("y", -42)
    .attr("text-anchor", "middle")
    .attr("fill", "#9ca3af")
    .attr("font-size", "0.85rem")
    .text("pair k · fast → slow");

  // X-axis labels
  [0, 200, 400, 600, 800].forEach(d => {
    g.append("text")
      .attr("x", x(d))
      .attr("y", innerH + 16)
      .attr("text-anchor", "middle")
      .attr("fill", "#9ca3af")
      .attr("font-size", "0.85rem")
      .text(`${d}`);
  });
  g.append("text")
    .attr("x", innerW / 2)
    .attr("y", innerH + 38)
    .attr("text-anchor", "middle")
    .attr("fill", "#9ca3af")
    .attr("font-size", "0.9rem")
    .text("distance between tokens (positions apart)");

  // Fast/slow band separator at row 16
  const splitY = y(SPLIT_K)!;
  g.append("line")
    .attr("x1", 0)
    .attr("x2", innerW)
    .attr("y1", splitY)
    .attr("y2", splitY)
    .attr("stroke", "rgba(255,255,255,0.45)")
    .attr("stroke-dasharray", "4,3")
    .attr("stroke-width", 1);
</script>
