---
import IconX from "@/assets/icons/IconX.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import { SITE } from "@/config";

const { pathname } = Astro.url;
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

// "Posts" owns the landing list ("/") and every post page ("/posts/…").
const postsActive = currentPath === "/" || currentPath.startsWith("/posts");
const isSection = (base: string) => currentPath.startsWith(base);
---

<header class="site-header bar-shine">
  <a id="skip-to-content" href="#main-content">Skip to content</a>
  <div class="header-inner">
    <a href="/" class="brand" aria-label={`${SITE.title} — home`}>
      <span class="logo-mark bevel-raised" aria-hidden="true"></span>
      <span class="brand-name">{SITE.title}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <button
        id="menu-btn"
        class="menu-btn bevel-raised"
        aria-label="Open Menu"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
      <ul id="menu-items" class="nav-list" data-open="false">
        <li>
          <a href="/" class="nav-btn bevel-raised" data-active={postsActive}>
            Posts
          </a>
        </li>
        <li>
          <a
            href="/tags"
            class="nav-btn bevel-raised"
            data-active={isSection("/tags")}
          >
            Tags
          </a>
        </li>
        <li>
          <a
            href="/vibes"
            class="nav-btn bevel-raised"
            data-active={isSection("/vibes")}
          >
            Vibes
          </a>
        </li>
        <li>
          <a
            href="/about"
            class="nav-btn bevel-raised"
            data-active={isSection("/about")}
          >
            About
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background: var(--surface-raised);
    border-bottom: 1px solid var(--line);
  }
  #skip-to-content {
    position: absolute;
    top: -100%;
    left: 4rem;
    z-index: 60;
    background: var(--surface);
    color: var(--accent);
    padding: 0.5rem 0.75rem;
    transition: top 0.2s;
  }
  #skip-to-content:focus {
    top: 0.75rem;
  }
  .header-inner {
    max-width: 1360px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 32px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .logo-mark {
    width: 14px;
    height: 14px;
    background: var(--accent);
    flex: none;
  }
  .brand-name {
    font-family: system-ui, -apple-system, sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: var(--text-strong);
    white-space: nowrap;
  }
  .nav {
    position: relative;
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-nav);
    background: var(--surface-btn);
    padding: 6px 14px;
    text-decoration: none;
  }
  .nav-btn:hover {
    background: var(--surface-btn-hover);
  }
  .nav-btn[data-active="true"] {
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
  }
  .menu-btn {
    display: none;
    background: var(--surface-btn);
    color: var(--text-nav);
    padding: 8px;
  }
  .hidden {
    display: none;
  }

  @media (max-width: 720px) {
    .header-inner {
      padding: 10px 16px;
    }
    .menu-btn {
      display: inline-flex;
    }
    .nav-list {
      display: none;
      position: absolute;
      right: 0;
      top: calc(100% + 10px);
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
      min-width: 168px;
      padding: 8px;
      background: var(--surface-raised);
      border: 1px solid var(--line);
      box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.35);
      z-index: 60;
    }
    .nav-list[data-open="true"] {
      display: flex;
    }
    .nav-btn {
      justify-content: flex-start;
      padding: 10px 14px;
    }
  }
</style>

<script>
  function bindNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");
    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const open = menuBtn.getAttribute("aria-expanded") === "true";
      menuBtn.setAttribute("aria-expanded", open ? "false" : "true");
      menuBtn.setAttribute("aria-label", open ? "Open Menu" : "Close Menu");
      menuItems.setAttribute("data-open", open ? "false" : "true");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  bindNav();
  document.addEventListener("astro:after-swap", bindNav);
</script>
