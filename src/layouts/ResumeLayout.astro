---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";

const { pageTitle } = Astro.props;
---

<Layout title={`${pageTitle} | ${SITE.title}`}>
  <Header />
  <Breadcrumb />
  <main id="main-content">
    <section id="about" class="app-prose mb-28 max-w-app prose-img:border-0">
      <slot />
    </section>
  </main>
  <Footer />
</Layout>

<style is:global>
  @reference '../styles/global.css';

  .pastel-holographic {
    font-size: 1.2rem;
    font-weight: bold;
    background: linear-gradient(90deg, #e8d9c9, #d8a7b1, #a8b8d8);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @keyframes pastel-flow {
    0% {
      background-position: 0% 0%;
    }
    100% {
      background-position: 300% 0%;
    }
  }

  .dancing-sprite {
    animation: dance 1s ease-in-out infinite;
  }

  .dancing-sprite:nth-child(1) {
    animation-delay: 1.1s;
    animation-duration: 1.9s;
  }
  .dancing-sprite:nth-child(2) {
    animation-delay: 0s;
    animation-duration: 2.1s;
  }
  .dancing-sprite:nth-child(3) {
    animation-delay: 0.7s;
    animation-duration: 2.3s;
  }
  .dancing-sprite:nth-child(4) {
    animation-delay: 0.3s;
    animation-duration: 1.8s;
  }
  .dancing-sprite:nth-child(5) {
    animation-delay: 0.5s;
    animation-duration: 2.2s;
  }

  @keyframes dance {
    0%,
    45% {
      transform: rotate(-15deg);
    }
    50%,
    95% {
      transform: rotate(15deg);
    }
    100% {
      transform: rotate(-15deg);
    }
  }
</style>
