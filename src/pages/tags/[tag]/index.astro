---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostRow from "@/components/PostRow.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { SITE } from "@/config";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const tags = getUniqueTags(posts);

  return tags.map(({ tag, tagName }) => ({
    params: { tag },
    props: { tag, tagName },
  }));
}

const { tag, tagName } = Astro.props;

const posts = await getCollection("blog");
const tagPosts = getPostsByTag(posts, tag);
const total = tagPosts.length;
---

<Layout title={`Tag: ${tagName} | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="posts-main">
    <a href="/tags" class="back-link">&lt;- cd ../tags</a>
    <div class="posts-head">
      <h1 class="posts-title">
        <span class="posts-hash" aria-hidden="true">#</span><span
          transition:name={tag}>{tagName}</span
        >
      </h1>
      <span class="posts-count">
        {total} {total === 1 ? "ENTRY" : "ENTRIES"}
      </span>
    </div>
    <div class="posts-rule" aria-hidden="true"></div>
    <ul class="post-list">
      {tagPosts.map(post => <PostRow post={post} />)}
    </ul>
  </main>
  <Footer />
</Layout>

<style>
  .posts-main {
    width: 100%;
    max-width: 884px;
    margin: 0 auto;
    padding: 56px 32px 96px;
  }
  .back-link {
    display: inline-block;
    margin-bottom: 18px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.03em;
    color: var(--text-muted);
    text-decoration: none;
  }
  .back-link:hover {
    color: var(--accent);
  }
  .posts-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .posts-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 34px;
    font-weight: 600;
    color: var(--text-strong);
  }
  .posts-hash {
    color: var(--accent);
    margin-right: 2px;
  }
  .posts-count {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .posts-rule {
    margin: 20px 0 12px;
    border-top: 1px dotted var(--divider);
  }
  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 700px) {
    .posts-main {
      padding: 40px 16px 72px;
    }
  }
</style>
