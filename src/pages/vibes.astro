---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const imports = import.meta.glob(
  "/src/assets/vibes/*.{jpg,jpeg,png,webp,avif,gif}",
  {
    eager: true,
    import: "default",
  }
) as Record<string, ImageMetadata>;

const images = Object.values(imports);
---

<html lang="en">
  <head>
    <title>Vibes</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      :root {
        --gap: 14px;
        --bg: #0c0c0c;
        --text: #eaeaea;
        --accent: #999;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
      }

      header {
        max-width: 1400px;
        margin: 1.5rem auto;
        padding: 0 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      a.back {
        color: var(--accent);
        text-decoration: none;
        font-size: 0.95rem;
      }

      a.back:hover {
        text-decoration: underline;
      }

      .wrap {
        max-width: 1400px;
        margin: 2rem auto;
        padding: 0 1rem;
      }

      .masonry {
        column-width: 280px;
        column-gap: var(--gap);
        column-fill: balance;
      }

      .item {
        break-inside: avoid;
        margin: 0 0 var(--gap);
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
        background: #111;
        transition:
          transform 0.15s ease,
          box-shadow 0.15s ease;
      }

      .item:hover {
        transform: scale(1.01);
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
      }

      .item img {
        display: block;
        width: 100%;
        height: auto;
      }

      h1 {
        margin-bottom: 1rem;
        font-size: 1.5rem;
        font-weight: 600;
      }
    </style>
  </head>

  <body>
    <header>
      <a class="back" href="/">← Back</a>
      <h1>Vibes</h1>
      <span></span>
    </header>

    <main class="wrap">
      <div id="grid" class="masonry">
        {
          images.map(img => (
            <figure class="item">
              <Image src={img} alt="" loading="lazy" decoding="async" />
            </figure>
          ))
        }
      </div>
    </main>

    <script is:inline>
      (function () {
        const g = document.getElementById("grid");
        const nodes = Array.from(g.children);
        for (let i = nodes.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          g.appendChild(nodes[j]);
          nodes.splice(j, 1);
        }
      })();
    </script>
  </body>
</html>
